<div
  id="JsCollectionProduct"
  class="{{ select_columns }} {{ settings.select_columns_sm }} {{ settings.select_columns_xs }}"
>
  {% if collection.handle == 'blem'
    or collection.handle == 'wake-foils'
    or collection.handle == 'wakeboard-blems'
    or collection.handle == 'water-ski-blems'
  %}
    <div class="collection-banner">
      <img
        src="https://cdn.shopify.com/s/files/1/0896/7726/7313/files/banner_a52b3f1a-dc5b-4e3b-8360-e5e50ac565f4.jpg?v=1746531200"
        class="collection-banner-img"
      >
    </div>
  {% endif %}

  {%- if layout_filter != 'on_top' -%}
    <div class="page-width" id="main-collection-filters" data-id="{{ section.id }}">
      {% include 'filter-dropdown', results: collection %}
    </div>
  {%- endif -%}
  <div class="js-collection-content-product">
    <div id="ProductGridContainer">
      {%- paginate collection.products by page_item -%}
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'collection_template.empty' | t -}}
                <br>
                {{
                  'collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
          <div id="product_result_count" class="hidden">{{ 'collection_template.empty' | t }}</div>
        {%- else -%}
          {%- if layout_filter == 'on_top' -%}
            <div class="page-width" id="main-collection-filters" data-id="{{ section.id }}">
              {% include 'filter-dropdown', results: collection %}
            </div>
          {%- endif -%}
          <div class="collection page-width {{ section.settings.layput_shop }}">
            <div id="product-grid" data-id="{{ section.id }}">
              <div class="products__row row">
                {%- for product in collection.products -%}
                  {% if product.type != 'Gift Cards' %}
                    <div class="products__col">
                      {% include 'product-grid-item' %}
                    </div>
                  {%- endif -%}
                {%- else -%}
                  <div class="products__no-matches">{{ 'collections.general.no_matches' | t }}</div>
                {%- endfor -%}
              </div>
              {%- assign min_page = 1 -%}
              {%- assign max_page = paginate.page_size | times: paginate.current_page -%}
              {%- if paginate.current_page > 1 -%}
                {%- assign current_page = paginate.current_page | minus: 1 -%}
              {%- endif -%}
              {%- if max_page > paginate.items -%}
                {%- assign max_page = paginate.items -%}
              {%- endif -%}
              {% assign percent = max_page | times: 100 | divided_by: paginate.items %}
              <div id="product_result_count" class="hidden">
                {{
                  'collections.general.product_count_html'
                  | t: min_page: min_page, max_page: max_page, items_page: paginate.items
                }}
              </div>
              {%- if max_page <= paginate.items -%}
                <div class="js-collection-{{ settings.select_pagination }} page-collection-footer">
                  {%- if section.settings.numproduct_enable
                    and settings.select_pagination == 'loadmore'
                    and percent < 100
                  -%}
                    <div class="collection-product-count">
                      {{
                        'collections.general.product_count_html'
                        | t: min_page: min_page, max_page: max_page, items_page: paginate.items
                      }}
                    </div>
                    <div class="content-percent"><div class="percent" style="width:{{percent}}%"></div></div>
                  {%- endif -%}
                  {%- if paginate.pages > 1 -%}
                    {% include 'pagination' %}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% schema %}
{
    "name": "Collection pages",
    "settings": [
		 {
        "type": "header",
        "content": "Collection"
      },
      {
        "type": "checkbox",
        "id": "categories_enable",
        "label": "Enable",
        "default": true,
		"info":"only used for filter dropdown and on top"
      },
      {
        "type": "text",
        "id": "categories_title",
        "label": "Heading",
        "default": "Collection",
		"info":"only used for filter dropdown and on top"
      },
	  {
      "type": "link_list",
      "id": "categories_menu",
      "label": "Menu",
	  "info":"only used for filter dropdown and on top"
    },
	  {
        "type": "checkbox",
        "id": "show_count",
        "label": "Show Count",
        "default": true,
		"info":"only used for filter dropdown and on top"
      },
	  {
        "type": "header",
        "content": "Layout shop"
      },
	  {
		  "type": "select",
		  "id": "layput_shop",
		  "label": "Layout shop",
		  "options": [
			{
			  "value": "simple",
			  "label": "Simple"
			},
			{
			  "value": "masonry",
			  "label": "Masonry"
			}
		  ],
		  "default": "simple"
		},
	  {
        "type": "header",
        "content": "Number products"
      },
		{
			"type": "range",
			"id": "page_item",
			"label": "Number of products in a page",
			"min": 1,
			"max": 24,
			"step": 1,
			"default": 12
		},
		{
			"type": "header",
			"content": "Product Count"
		},
		{
			"type": "checkbox",
			"id": "numproduct_enable",
			"label": "Enable",
			"default": true
		}
    ]
}
{% endschema %}
