{{ 'css-section-product-single.css' | asset_url | stylesheet_tag }}
{%- if section.settings.fullwidth -%}
  {%- assign container = 'container-full' -%}
{%- elsif section.settings.max_width != blank -%}
  {%- assign container = 'bwp-container' -%}
{%- else -%}
  {%- assign container = 'container' -%}
{%- endif -%}

{%- assign max_width = '' -%}
{%- if section.settings.fullwidth == blank and section.settings.max_width != blank -%}
  {%- assign width_container = section.settings.max_width | plus: 0 -%}
  {%- capture max_width -%}style="max-width: {{ section.settings.max_width }};"{%- endcapture -%}
{%- endif -%}

{%- assign collection_handle = section.settings.featured_products -%}
{%- assign nav = section.settings.navigation -%}
{%- assign infinite = section.settings.infinite -%}
{%- assign autoplay = section.settings.autoplay -%}
{%- assign autoplay_speed = section.settings.autoplay_speed | escape -%}
{%- assign columns = section.settings.columns -%}
{%- assign column1440 = section.settings.column1440 -%}
{%- assign column1 = section.settings.column1 -%}
{%- assign column2 = section.settings.column2 -%}
{%- assign column3 = section.settings.column3 -%}
{%- assign column4 = section.settings.column4 -%}
{%- assign limit = section.settings.limit | plus: 0 -%}

{% assign margin = section.settings.margin | split: '|' %}
{% assign padding = section.settings.padding | split: '|' %}
{%- style -%}
  {%- if section.settings.color_bg != blank -%}
  	{%- if section.settings.width_bg == 'full' -%}
  		#shopify-section-{{ section.id }}{
  			background:{{ section.settings.color_bg }};
  		}
  	{%- elsif section.settings.width_bg == 'container' -%}
  		#shopify-section-{{ section.id }} .wpbingo-section__inner{
  			background:{{ section.settings.color_bg }};
  			{%- if section.settings.padding_bg != blank -%}padding:{{ section.settings.padding_bg }};{%- endif -%}
  		}
  	{%- endif -%}
  {%- endif -%}
  {%- if section.settings.fullwidth == blank and section.settings.max_width != blank and width_container > 1200 -%}
  	@media (max-width: {{ section.settings.max_width }}) and (min-width: 1200px){
  		#shopify-section-{{ section.id }} .bwp-container{
  			padding-left:30px;
  			padding-right:30px;
  		}
  	}
  {%- endif -%}
  {%- if margin[0] != blank or padding[0] != blank -%}
  	#shopify-section-{{ section.id }} .wpbingo-section--products-single{
  		{%- if margin[0] != blank -%}margin: {{ margin[0] }};{%- endif -%}
  		{%- if padding[0] != blank -%}padding:{{ padding[0] }};{%- endif -%}
  	}
  {%- endif -%}
  {%- if margin[1] != blank or padding[1] != blank -%}
  	@media (max-width:1200px){
  		#shopify-section-{{ section.id }} .wpbingo-section--products-single{
  			{%- if margin[1] != blank -%}margin: {{ margin[1] }};{%- endif -%}
  			{%- if padding[1] != blank -%}padding:{{ padding[1] }};{%- endif -%}
  		}
  	}
  {%- endif -%}
  {%- if margin[2] != blank or padding[2] != blank -%}
  	@media (max-width:991px){
  		#shopify-section-{{ section.id }} .wpbingo-section--products-single{
  			{%- if margin[2] != blank -%}margin: {{ margin[2] }};{%- endif -%}
  			{%- if padding[2] != blank -%}padding:{{ padding[2] }};{%- endif -%}
  		}
  	}
  {%- endif -%}
  {%- if margin[3] != blank or padding[3] != blank -%}
  	@media (max-width:767px){
  		#shopify-section-{{ section.id }} .wpbingo-section--products-single{
  			{%- if margin[3] != blank -%}margin: {{ margin[3] }};{%- endif -%}
  			{%- if padding[3] != blank -%}padding:{{ padding[3] }};{%- endif -%}
  		}
  	}
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
  	{%- for block in section.blocks -%}
  		{%- if block.type == 'css' -%}
  			#shopify-section-{{ section.id }} .wpbingo-section--products-single .desc{
  				font-size: {{ block.settings.font_size_subtitle }}px;
  				line-height: {{ block.settings.line_height_subtitle }}px;
  				font-weight: {{ block.settings.font_weight_subtitle }};
  				letter-spacing:{{ block.settings.letter_spacing_subtitle }}px;
  				color:{{ block.settings.color_subtitle }};
  				margin:{{ block.settings.margin_subtitle }};
  			}
  			#shopify-section-{{ section.id }} .wpbingo-section--products-single .title-product{
  				font-size: {{ block.settings.font_size_title }}px;
  				line-height: {{ block.settings.line_height_title }}px;
  				font-weight: {{ block.settings.font_weight_title }};
  				letter-spacing:{{ block.settings.letter_spacing_title }}px;
  				color:{{ block.settings.color_title }};
  				margin:{{ block.settings.margin_title }};
  			}
                 #shopify-section-{{ section.id }} .wpbingo-section--products-single .bwp-button{
  				font-size:{{ block.settings.font_size_button }}px;
  				line-height:{{ block.settings.line_height_button }}px;
  				font-weight:{{ block.settings.font_weight_button }};
  				letter-spacing:{{ block.settings.letter_spacing_button }}px;
  				color:{{ block.settings.color_button }};
  				background:{{ block.settings.bg_button }};
  				padding:{{ block.settings.padding_button }};
  				overflow:hidden;
  				{%- if block.settings.border -%}
  					border:{{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  					border-radius:{{ block.settings.border_radius }};
  				{%- endif -%}
  			}
  			#shopify-section-{{ section.id }} .wpbingo-section--products-single .bwp-button:hover{
  				color:{{ block.settings.color_hover_button }};
  				border-color:{{ block.settings.border_color_hover_button }};
  			}
  			#shopify-section-{{ section.id }} .wpbingo-section--products-single .bwp-button:hover:before{
  				background:{{ block.settings.bg_hover_button }};
  			}
  			#shopify-section-{{ section.id }} .wpbingo-section--products-single .bwp-button i{
  				font-size:{{ block.settings.font_icon }}px;
  				top:{{ block.settings.pos_icon }}px;
  				position:relative;
  				margin: {{ block.settings.margin_icon }}
  			}
  			@media(max-width:767px){
  				#shopify-section-{{ section.id }} .wpbingo-section--products-single .desc{
  					font-size: {{ block.settings.font_size_subtitle_mobi }}px;
  					line-height: {{ block.settings.line_height_subtitle_mobi }}px;
  					margin:{{ block.settings.margin_subtitle_mobi }};
  				}
  				#shopify-section-{{ section.id }} .wpbingo-section--products-single .title-product{
  					font-size: {{ block.settings.font_size_title_mobi }}px;
  					line-height: {{ block.settings.line_height_title_mobi }}px;
  					margin:{{ block.settings.margin_title_mobi }};
  				}
                     #shopify-section-{{ section.id }} .wpbingo-section--products-single .bwp-button{
  					font-size: {{ block.settings.font_size_button_mobi }}px;
  					line-height: {{ block.settings.line_height_button_mobi }}px;
  					padding:{{ block.settings.padding_button_mobi }};
  					border-radius:{{ block.settings.border_radius_mobi }};
  					{%- if block.settings.border -%}
  						border-width:{{ block.settings.border_width }}px;
  					{%- endif -%}
  				}
  				#shopify-section-{{ section.id }} .wpbingo-section--products-single .bwp-button i{
  					font-size:{{ block.settings.font_icon_mobi }}px;
  					top:{{ block.settings.margin_icon_mobi }}px;
  				}
  			}
  		{%- endif -%}
  	{%- endfor -%}
  {%- endif -%}
{%- endstyle -%}
<section class="wpbingo-section wpbingo-section--products-single overflow-hidden wpbingo-section--{{ section.id }}">
  <div class="{{ container }}" {{ max_width }}>
    <div class="wpbingo-section__inner">
      <div class="content-info">
        <h3 class="title-product">{{ section.settings.heading }}</h3>
        {%- if section.settings.desc != blank -%}
          <div class="desc">{{ section.settings.desc }}</div>
        {%- endif -%}
        {%- if section.settings.button != blank -%}
          <a class="bwp-button" href="{{ section.settings.button_url }}">
            {{ section.settings.button }}
            {%- if section.settings.icon_title -%}
              <i class="{{ section.settings.icon_title }}"></i>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
      <div class="wpbingo-section__content bwp_slider-carousel{% if section.settings.half_slider != blank %} bwp_slick-margin-mobile{% endif %}">
        <div
          class="js-carousel slick-carousel"
          data-nav="{{ nav }}"
          data-infinite="{{ infinite }}"
          data-autoplay="{{ autoplay }}"
          data-autoplayspeed="{{ autoplay_speed }}"
          data-columns="{{ columns }}"
          data-column1440="{{ column1440 }}"
          data-column1="{{ column1 }}"
          data-column2="{{ column2 }}"
          data-column3="{{ column3 }}"
          data-column4="{{ column4 }}"
        >
          {%- if collection_handle == blank
            or collections[collection_handle] == empty
            or collections[collection_handle].products_count == 0
          -%}
            {% include 'onboarding-featured-products' %}
          {%- else -%}
            {%- for product in collections[collection_handle].products limit: limit -%}
              <div class="slick-carousel__item">
                {% include 'product-grid-item' %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
