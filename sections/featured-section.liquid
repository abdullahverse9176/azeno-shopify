{{ 'featured-section.css' | asset_url | stylesheet_tag }}

<section class="featured-products">
  <div class="featured-products__header">
    <h2>Featured Products</h2>
    <p>Discover our latest products</p>
  </div>

  <div class="featured-products__grid">
    <!-- Product Card -->

    {% for product in collections.product %}
    <div class="product-card">
      <a href="#" class="product-card__image">
        <img src="{{ product.featured_image }}" alt="{{ product.title }}" width: "400" height: "400">
      </a>

      <div class="product-card__content">
        <h3 class="product-card__title">T-Shirt</h3>

        <p class="product-card__price">$29.99</p>

        <button type="button" class="product-card__button">Add to Cart</button>
      </div>
    {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Section"
    }
  ]
}
{% endschema %}
