{{ 'featured-section.css' | asset_url | stylesheet_tag }}

<section class="featured-products">
  <div class="featured-products__header">
    <h2>Featured Products</h2>
    <p>Discover our latest products</p>
  </div>

  {% if section.settings.collection != blank %}
    <div class="featured-products__grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        <div class="product-card">
          <a href="{{ product.url }}" class="product-card__image">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 400 }}"
                alt="{{ product.featured_image.alt | escape }}"
                width="400"
                height="400"
              >
            {% endif %}
          </a>

          <div class="product-card__content">
            <h3 class="product-card__title">
              {{ product.title }}
            </h3>

            <p class="featured-products__price">
              {% if product.compare_at_price > product.price %}
                <span class="product-card__price">
                  {{ product.price | money }}
                </span>
                |

                <span class="product-card__price">
                  {{ product.compare_at_price | money }}
                </span>

              {% else %}
                <span class="product-card__price">
                  {{ product.price | money }}
                </span>
              {% endif %}
            </p>

            <form
              action="{{ routes.cart_add_url }}"
              method="post"
              class="product-card__form"
            >
              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
              >

              <button type="submit" class="product-card__button">Add to Cart</button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>

  {% else %}
    <p class="featured-products__empty">Please select a collection.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured Section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "select",
      "id": "products_to_show",
      "label": "Products to show",
      "options": [
        {
          "value": "2",
          "label": "2 Products"
        },
        {
          "value": "4",
          "label": "4 Products"
        },
        {
          "value": "6",
          "label": "6 Products"
        },
        {
          "value": "8",
          "label": "8 Products"
        }
      ],
      "default": "4"
    }
  ],
  "presets": [
    {
      "name": "Featured Section"
    }
  ]
}
{% endschema %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const forms = document.querySelectorAll('.product-card__form');

    forms.forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const button = form.querySelector('.product-card__button');
        const formData = new FormData(form);

        button.disabled = true;
        button.textContent = 'Adding...';

        try {
          // Add product to cart
          const response = await fetch(form.action + '.js', {
            method: 'POST',
            headers: {
              Accept: 'application/json',
            },
            body: formData,
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.description || 'Product add nahi hua');
          }

          console.log('Product added:', data);

          /*
           * Cart drawer ka latest content lao
           */
          const cartResponse = await fetch(window.Shopify.routes.root + 'cart.js');

          const cart = await cartResponse.json();

          console.log('Updated cart:', cart);

          /*
           * Drawer ko find karo
           */
          const drawer = document.querySelector('.js-drawer');
          const overlay = document.querySelector('.drawer__overlay');

          if (drawer) {
            /*
             * Drawer open
             */
            drawer.classList.add('is-open');

            if (overlay) {
              overlay.classList.add('is-open');
            }
          }

          button.disabled = false;
          button.textContent = 'Added ✓';

          setTimeout(() => {
            button.textContent = 'Add to Cart';
          }, 1500);
        } catch (error) {
          console.error('Add to cart error:', error);

          button.disabled = false;
          button.textContent = 'Add to Cart';
        }
      });
    });
  });
</script>
