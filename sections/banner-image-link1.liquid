{% schema %}
{
  "name": "Banner Image Slider",
  "settings": [
    {
      "type": "header",
      "content": "Slide 1"
    },
    {
      "type": "image_picker",
      "id": "banner_image_1",
      "label": "Banner Image 1"
    },
    {
      "type": "url",
      "id": "banner_link_1",
      "label": "Banner Link 1"
    },
    {
      "type": "text",
      "id": "banner_btn_text_1",
      "label": "Button Text 1",
      "default": "Shop Now"
    },
    {
      "type": "text",
      "id": "alt_text_1",
      "label": "Alt Text 1",
      "default": "Banner Image"
    },
    {
      "type": "header",
      "content": "Slide 2"
    },
    {
      "type": "image_picker",
      "id": "banner_image_2",
      "label": "Banner Image 2"
    },
    {
      "type": "url",
      "id": "banner_link_2",
      "label": "Banner Link 2"
    },
    {
      "type": "text",
      "id": "banner_btn_text_2",
      "label": "Button Text 2",
      "default": "Shop Now"
    },
    {
      "type": "text",
      "id": "alt_text_2",
      "label": "Alt Text 2",
      "default": "Banner Image"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Image Height (desktop)",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "400px", "label": "400px" },
        { "value": "600px", "label": "600px" },
        { "value": "800px", "label": "800px" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "image_height_mobile",
      "label": "Image Height (mobile)",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "250px", "label": "250px" },
        { "value": "350px", "label": "350px" },
        { "value": "450px", "label": "450px" }
      ],
      "default": "auto"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "select",
      "id": "button_position",
      "label": "Button position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "button_vertical",
      "label": "Button vertical position",
      "min": 10,
      "max": 92,
      "step": 1,
      "unit": "%",
      "default": 82,
      "info": "Only used when Button position is Center."
    },
    {
      "type": "range",
      "id": "button_bottom",
      "label": "Button distance from bottom",
      "min": 40,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 70,
      "info": "Only used for the Bottom positions."
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button hover background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button hover text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Banner Image Slider",
      "category": "Image"
    }
  ]
}
{% endschema %}

{%- liquid
  assign s = section.settings
  assign section_id = section.id

  assign slide_count = 0
  if s.banner_image_1 != blank
    assign slide_count = slide_count | plus: 1
  endif
  if s.banner_image_2 != blank
    assign slide_count = slide_count | plus: 1
  endif

  assign autoplay_ms = s.autoplay_speed | times: 1000
-%}

{%- if slide_count > 0 -%}
  <style>
    #BannerSlider-{{ section_id }} {
      --bis-height: {{ s.image_height | default: 'auto' }};
      --bis-height-mobile: {{ s.image_height_mobile | default: 'auto' }};
      --bis-btn-text: {{ s.button_text_color }};
      --bis-btn-border: {{ s.button_border_color }};
      --bis-btn-hover-bg: {{ s.button_hover_bg }};
      --bis-btn-hover-text: {{ s.button_hover_text }};
      --bis-btn-top: {{ s.button_vertical | default: 82 }}%;
      --bis-btn-bottom: {{ s.button_bottom | default: 70 }}px;
      position: relative;
      overflow: hidden;
    }

    #BannerSlider-{{ section_id }} .bis__viewport {
      position: relative;
      width: 100%;
      overflow: hidden;
      touch-action: pan-y;
    }

    #BannerSlider-{{ section_id }} .bis__track {
      display: flex;
      width: 100%;
      transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      will-change: transform;
    }

    #BannerSlider-{{ section_id }}.is-dragging .bis__track {
      transition: none;
    }

    #BannerSlider-{{ section_id }} .bis__slide {
      position: relative;
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
    }

    #BannerSlider-{{ section_id }} .bis__image {
      display: block;
      width: 100%;
      height: var(--bis-height);
      object-fit: cover;
    }

    #BannerSlider-{{ section_id }} .bis__media-link {
      display: block;
      line-height: 0;
    }

    #BannerSlider-{{ section_id }} .bis__btn {
      position: absolute;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 13px 30px;
      font-size: 16px;
      line-height: 1;
      text-decoration: none;
      border: 1px solid var(--bis-btn-border);
      border-radius: 3px;
      background: transparent;
      color: var(--bis-btn-text);
      transition: background-color 0.35s ease, color 0.35s ease;
    }

    #BannerSlider-{{ section_id }} .bis__btn:hover,
    #BannerSlider-{{ section_id }} .bis__btn:focus-visible {
      background: var(--bis-btn-hover-bg);
      color: var(--bis-btn-hover-text);
    }

    {%- case s.button_position -%}
      {%- when 'bottom-center' -%}
        #BannerSlider-{{ section_id }} .bis__btn {
          left: 50%;
          bottom: var(--bis-btn-bottom);
          transform: translateX(-50%);
        }
      {%- when 'bottom-left' -%}
        #BannerSlider-{{ section_id }} .bis__btn {
          left: 6%;
          bottom: var(--bis-btn-bottom);
        }
      {%- when 'bottom-right' -%}
        #BannerSlider-{{ section_id }} .bis__btn {
          right: 6%;
          bottom: var(--bis-btn-bottom);
        }
      {%- else -%}
        #BannerSlider-{{ section_id }} .bis__btn {
          left: 50%;
          top: var(--bis-btn-top);
          transform: translate(-50%, -50%);
        }
    {%- endcase -%}

    #BannerSlider-{{ section_id }} .bis__arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 4;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.35);
      color: #fff;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    #BannerSlider-{{ section_id }} .bis__arrow:hover {
      background: rgba(0, 0, 0, 0.6);
    }

    #BannerSlider-{{ section_id }} .bis__arrow--prev { left: 16px; }
    #BannerSlider-{{ section_id }} .bis__arrow--next { right: 16px; }

    #BannerSlider-{{ section_id }} .bis__arrow svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }

    #BannerSlider-{{ section_id }} .bis__dots {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 4;
      display: flex;
      gap: 8px;
      margin: 0;
      padding: 0;
    }

    #BannerSlider-{{ section_id }} .bis__dot {
      width: 10px;
      height: 10px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.5);
      cursor: pointer;
      transition: background-color 0.3s ease, transform 0.3s ease;
    }

    #BannerSlider-{{ section_id }} .bis__dot[aria-selected='true'] {
      background: #fff;
      transform: scale(1.2);
    }

    @media screen and (max-width: 749px) {
      #BannerSlider-{{ section_id }} .bis__image { height: var(--bis-height-mobile); }
      #BannerSlider-{{ section_id }} .bis__btn { padding: 10px 22px; font-size: 14px; }
      #BannerSlider-{{ section_id }} .bis__dots { bottom: 14px; }
      #BannerSlider-{{ section_id }} .bis__arrow { width: 36px; height: 36px; }
      #BannerSlider-{{ section_id }} .bis__arrow--prev { left: 8px; }
      #BannerSlider-{{ section_id }} .bis__arrow--next { right: 8px; }
    }

    @media (prefers-reduced-motion: reduce) {
      #BannerSlider-{{ section_id }} .bis__track { transition: none; }
    }
  </style>

  <section
    id="BannerSlider-{{ section_id }}"
    class="banner-image-slider-section"
    data-autoplay="{% if s.autoplay and slide_count > 1 %}true{% else %}false{% endif %}"
    data-autoplay-speed="{{ autoplay_ms }}"
    aria-roledescription="carousel"
    aria-label="Banner slider"
  >
    <div class="bis__viewport" data-viewport>
      <div class="bis__track" data-track>
        {%- if s.banner_image_1 != blank -%}
          <div class="bis__slide" data-slide aria-roledescription="slide" aria-label="Slide 1 of {{ slide_count }}">
            {%- if s.banner_link_1 != blank -%}
              <a class="bis__media-link" href="{{ s.banner_link_1 }}" tabindex="-1" aria-hidden="true">
            {%- endif -%}
            <img
              class="bis__image"
              src="{{ s.banner_image_1 | image_url: width: 2000 }}"
              srcset="{{ s.banner_image_1 | image_url: width: 750 }} 750w,
                      {{ s.banner_image_1 | image_url: width: 1100 }} 1100w,
                      {{ s.banner_image_1 | image_url: width: 1500 }} 1500w,
                      {{ s.banner_image_1 | image_url: width: 2000 }} 2000w"
              sizes="100vw"
              width="{{ s.banner_image_1.width }}"
              height="{{ s.banner_image_1.height }}"
              alt="{{ s.alt_text_1 | escape }}"
              loading="eager"
              fetchpriority="high"
              draggable="false"
            >
            {%- if s.banner_link_1 != blank -%}
              </a>
            {%- endif -%}

            {%- if s.banner_link_1 != blank and s.banner_btn_text_1 != blank -%}
              <a class="bis__btn" href="{{ s.banner_link_1 }}">{{ s.banner_btn_text_1 | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.banner_image_2 != blank -%}
          <div class="bis__slide" data-slide aria-roledescription="slide" aria-label="Slide {{ slide_count }} of {{ slide_count }}">
            {%- if s.banner_link_2 != blank -%}
              <a class="bis__media-link" href="{{ s.banner_link_2 }}" tabindex="-1" aria-hidden="true">
            {%- endif -%}
            <img
              class="bis__image"
              src="{{ s.banner_image_2 | image_url: width: 2000 }}"
              srcset="{{ s.banner_image_2 | image_url: width: 750 }} 750w,
                      {{ s.banner_image_2 | image_url: width: 1100 }} 1100w,
                      {{ s.banner_image_2 | image_url: width: 1500 }} 1500w,
                      {{ s.banner_image_2 | image_url: width: 2000 }} 2000w"
              sizes="100vw"
              width="{{ s.banner_image_2.width }}"
              height="{{ s.banner_image_2.height }}"
              alt="{{ s.alt_text_2 | escape }}"
              loading="lazy"
              draggable="false"
            >
            {%- if s.banner_link_2 != blank -%}
              </a>
            {%- endif -%}

            {%- if s.banner_link_2 != blank and s.banner_btn_text_2 != blank -%}
              <a class="bis__btn" href="{{ s.banner_link_2 }}">{{ s.banner_btn_text_2 | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if s.show_arrows and slide_count > 1 -%}
      <button type="button" class="bis__arrow bis__arrow--prev" data-prev aria-label="Previous slide">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M15.4 4.6 13.9 3 5 12l8.9 9 1.5-1.6L8.1 12z"/>
        </svg>
      </button>
      <button type="button" class="bis__arrow bis__arrow--next" data-next aria-label="Next slide">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m8.6 4.6 1.5-1.6 8.9 9-8.9 9-1.5-1.6 7.3-7.4z"/>
        </svg>
      </button>
    {%- endif -%}

    {%- if s.show_dots and slide_count > 1 -%}
      <div class="bis__dots" role="tablist" data-dots>
        {%- for i in (1..slide_count) -%}
          <button
            type="button"
            class="bis__dot"
            role="tab"
            data-dot
            data-index="{{ forloop.index0 }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </section>

  <script>
    (function () {
      function initBannerSlider(root) {
        if (!root || root.dataset.bisInit === 'true') return;
        root.dataset.bisInit = 'true';

        var viewport = root.querySelector('[data-viewport]');
        var track = root.querySelector('[data-track]');
        var slides = Array.prototype.slice.call(root.querySelectorAll('[data-slide]'));
        var dots = Array.prototype.slice.call(root.querySelectorAll('[data-dot]'));
        var prevBtn = root.querySelector('[data-prev]');
        var nextBtn = root.querySelector('[data-next]');

        if (!viewport || !track || slides.length === 0) return;

        var index = 0;
        var total = slides.length;
        var timer = null;
        var autoplay = root.dataset.autoplay === 'true' && total > 1;
        var speed = parseInt(root.dataset.autoplaySpeed, 10) || 5000;

        function render() {
          track.style.transform = 'translateX(' + (-index * 100) + '%)';

          slides.forEach(function (slide, i) {
            var isActive = i === index;
            slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
            Array.prototype.forEach.call(slide.querySelectorAll('a'), function (link) {
              if (link.classList.contains('bis__media-link')) return;
              link.tabIndex = isActive ? 0 : -1;
            });
          });

          dots.forEach(function (dot, i) {
            dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
          });
        }

        function goTo(next) {
          index = ((next % total) + total) % total;
          render();
        }

        function stop() {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        }

        function start() {
          if (!autoplay) return;
          stop();
          timer = setInterval(function () {
            goTo(index + 1);
          }, speed);
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', function () {
            goTo(index - 1);
            start();
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function () {
            goTo(index + 1);
            start();
          });
        }

        dots.forEach(function (dot) {
          dot.addEventListener('click', function () {
            goTo(parseInt(dot.dataset.index, 10) || 0);
            start();
          });
        });

        root.addEventListener('mouseenter', stop);
        root.addEventListener('mouseleave', start);
        root.addEventListener('focusin', stop);
        root.addEventListener('focusout', start);

        document.addEventListener('visibilitychange', function () {
          if (document.hidden) {
            stop();
          } else {
            start();
          }
        });

        /* keyboard */
        root.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowLeft') {
            goTo(index - 1);
            start();
          } else if (e.key === 'ArrowRight') {
            goTo(index + 1);
            start();
          }
        });

        /* touch + mouse drag */
        var startX = 0;
        var deltaX = 0;
        var dragging = false;

        function pointerDown(e) {
          if (total < 2) return;
          dragging = true;
          deltaX = 0;
          startX = e.touches ? e.touches[0].clientX : e.clientX;
          root.classList.add('is-dragging');
          stop();
        }

        function pointerMove(e) {
          if (!dragging) return;
          var x = e.touches ? e.touches[0].clientX : e.clientX;
          deltaX = x - startX;
          var percent = (deltaX / viewport.offsetWidth) * 100;
          track.style.transform = 'translateX(' + ((-index * 100) + percent) + '%)';
        }

        function pointerUp() {
          if (!dragging) return;
          dragging = false;
          root.classList.remove('is-dragging');

          var threshold = viewport.offsetWidth * 0.15;
          if (deltaX > threshold) {
            goTo(index - 1);
          } else if (deltaX < -threshold) {
            goTo(index + 1);
          } else {
            render();
          }
          start();
        }

        viewport.addEventListener('touchstart', pointerDown, { passive: true });
        viewport.addEventListener('touchmove', pointerMove, { passive: true });
        viewport.addEventListener('touchend', pointerUp);
        viewport.addEventListener('mousedown', pointerDown);
        window.addEventListener('mousemove', pointerMove);
        window.addEventListener('mouseup', pointerUp);

        /* swallow the click that ends a real drag so the image link does not fire */
        viewport.addEventListener('click', function (e) {
          if (Math.abs(deltaX) > 10) {
            e.preventDefault();
            e.stopPropagation();
          }
        }, true);

        render();
        start();

        root.bisDestroy = stop;
      }

      function initAll() {
        Array.prototype.forEach.call(
          document.querySelectorAll('[id^="BannerSlider-"]'),
          initBannerSlider
        );
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
      } else {
        initAll();
      }

      /* theme editor */
      document.addEventListener('shopify:section:load', function (e) {
        var el = e.target.querySelector('[id^="BannerSlider-"]');
        if (el) initBannerSlider(el);
      });

      document.addEventListener('shopify:section:unload', function (e) {
        var el = e.target.querySelector('[id^="BannerSlider-"]');
        if (el && typeof el.bisDestroy === 'function') el.bisDestroy();
      });
    })();
  </script>
{%- endif -%}
