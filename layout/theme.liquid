<!doctype html>
{%- if settings.iso_rtl != blank and settings.enable_rtl -%}
  {%- assign is_rtl = fasle -%}
  {%- assign iso_code_arr_rtl = settings.iso_rtl | split: ';' -%}
  {%- for iso_arr_rtl in iso_code_arr_rtl -%}
    {%- assign iso_rtl = iso_arr_rtl | remove: ' ' -%}
    {%- if iso_rtl == shop.locale -%}
      {%- assign is_rtl = true -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
<html class="js" lang="en-US">
  <head>
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta name="author" content="Buy Wake Works">
<meta name="publisher" content="Buy Wake Works">
<meta name="keywords" content="Wakeboarding, Hyperlite, Wake Surf, Wakesurf, Wakesurf Board, Ronix, Hyperlite Wakeboard, Wakeboard Bindings, Ronix Wakeboards, Wake Surf Boards, Wakeskate, Wakeboard Rope, Wakeboards for Sale, Wakeboard Life Jacket, Ronix Bindings">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    {% if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
    {%- endif %}
    <!-- ibr code -->
    <meta name="google-site-verification" content="UvQn0J2U3uQr8BB96PfqpYGbW-50CzEaa23c1L8ys0Y" />
<title>
  {%- if template.name == 'product' -%}
    {%- if product.metafields.global.title_tag != blank -%}
      {{ product.metafields.global.title_tag }}
    {%- else -%}
      {{ page_title | append: " - Wholesale" }}
    {%- endif -%}
  {%- elsif template.name == 'collection' -%}
    {%- if collection.handle == 'all' -%}
      Shop All Gear | Wake, Snow & Outdoor Equipment | BuyWakeWorks
    {%- elsif collection.metafields.global.title_tag != blank -%}
      {{ collection.metafields.global.title_tag }}
    {%- else -%}
      {{ page_title }}
    {%- endif -%}
  {%- elsif template.name == 'cart' -%}
    Your Shopping Cart | BuyWakeWorks
  {%- elsif template.name == 'policy' -%}
    {%- if request.path contains 'privacy-policy' -%}
      Privacy Policy | BuyWakeWorks
    {%- else -%}
      {{ page_title }} | BuyWakeWorks
    {%- endif -%}
  {%- else -%}
    {{ page_title }}
  {%- endif -%}
  
  {%- if current_tags -%}
    {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
  {%- endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
</title>
{% if template == "index" %}
<h1 class="visually-hidden" style="display:none;">Shop Premium Wakeboards, Boat Parts & Watersports Gear</h1>
